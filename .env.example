# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
# Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Landing page (visitante sem login é redirecionado para ela)
VITE_LANDING_URL=https://driver-cash-web-site.vercel.app/

# Planos de assinatura do Mercado Pago (públicos, aparecem na tela de assinatura)
VITE_MP_CHECKOUT_MENSAL=https://www.mercadopago.com.br/subscriptions/checkout?preapproval_plan_id=XXXX
VITE_MP_PRICE_MENSAL=19.90
VITE_MP_CHECKOUT_ANUAL=https://www.mercadopago.com.br/subscriptions/checkout?preapproval_plan_id=YYYY
VITE_MP_PRICE_ANUAL=199.00
VITE_MP_ANUAL_DESTAQUE=2 meses grátis

# --- Somente no painel da Netlify (Site settings -> Environment variables) ---
# NUNCA coloque estas no .env do projeto nem no GitHub.
# MP_ACCESS_TOKEN=APP_USR-...          (Mercado Pago -> Suas integrações -> Credenciais de produção)
# MP_WEBHOOK_SECRET=...                (Mercado Pago -> Suas integrações -> Webhooks -> Assinatura secreta)
# SUPABASE_SERVICE_ROLE_KEY=...        (Supabase -> Project Settings -> API -> service_role)
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
