# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase.
# Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Link de checkout da oferta na Hotmart (público, aparece na tela de assinatura)
VITE_HOTMART_CHECKOUT_URL=https://pay.hotmart.com/SEU-CODIGO

# --- Somente no painel da Netlify (Site settings -> Environment variables) ---
# NUNCA coloque estas duas no .env do projeto nem no GitHub.
# HOTMART_HOTTOK=token-do-webhook-hotmart
# SUPABASE_SERVICE_ROLE_KEY=chave-service-role-do-supabase
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
